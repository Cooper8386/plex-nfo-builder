# Required: access token for the API (the app is fail-closed without it).
# Generate one with:  openssl rand -hex 32
API_TOKEN=
# Optional: comma-separated CORS origin allowlist (leave empty for the
# same-origin bundled UI) and Host header allowlist for DNS-rebinding defense.
CORS_ALLOW_ORIGINS=
TRUSTED_HOSTS=
TVDB_API_KEY=
TVDB_PIN=
TZ=America/Chicago
